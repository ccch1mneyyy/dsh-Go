// dshgo-share (docs/design/share-links.md). No secrets here: ADMIN_KEY,
// BETA_SECRET and USAGE_SECRET are Worker secrets (provision.sh, beta-keys.sh
// init, docs/release.md「统计」), and so is the optional GITHUB_TOKEN (the home
// page's star count, src/github.ts); the API token is passed in by the scripts.
// The account id and the KV namespace id below are placeholders in the public
// tree: the scripts take the real ones from the environment or ~/keys and run
// wrangler with a copy of this file that has them (scripts/cloudflare.sh);
// provision.sh apply creates the bucket and the KV namespace. Forks: your own
// ids there, and your own route.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dshgo-share",
  // Your Cloudflare account id (placeholder; stats.sh and publish-release.sh read it here).
  "account_id": "00000000000000000000000000000000",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Only the custom domain: *.workers.dev is unreliable from mainland China.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "go.dshtui.com", "custom_domain": true }],
  // Copies the site pages (site/build/share) into public/ before every dev / deploy.
  "build": { "command": "node scripts/build-site.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request goes through the Worker, which picks the file and adds
    // the security headers; paths are taken literally.
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Lifecycle rules on this bucket: 7d/ → 7 days, 30d/ → 30 days (provision.sh).
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "dshgo-share" }],
  // Hourly upload counters (src/limits.ts). The id: scripts/cloudflare.sh.
  "kv_namespaces": [{ "binding": "QUOTA", "id": "00000000000000000000000000000000" }],
  // Wrong beta access keys, one object per client (src/beta-guard.ts); the
  // day's random salt for device codes, one object (src/stats.ts).
  "durable_objects": {
    "bindings": [
      { "name": "BETA_GUARD", "class_name": "BetaGuard" },
      { "name": "STATS_SALT", "class_name": "StatsSalt" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BetaGuard"] },
    { "tag": "v2", "new_sqlite_classes": ["StatsSalt"] }
  ],
  // Download clicks, update checks, the app's usage reports (src/stats.ts,
  // src/usage.ts). Analytics Engine isn't enabled on the account yet, so
  // provision.sh deploys without them unless --analytics (or DSH_ANALYTICS=1):
  // until then nothing is counted and /api/usage/v1 is 404. wrangler dev has
  // them locally. docs/design/share-links.md §15.
  "analytics_engine_datasets": [
    { "binding": "DOWNLOADS", "dataset": "dshgo_downloads" },
    { "binding": "CHECKS", "dataset": "dshgo_checks" },
    { "binding": "USAGE", "dataset": "dshgo_usage" }
  ],
  "ratelimits": [
    { "name": "UPLOAD_BURST", "namespace_id": "42001", "simple": { "limit": 5, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "42002", "simple": { "limit": 120, "period": 60 } },
    { "name": "USAGE_LIMIT", "namespace_id": "42003", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "UPLOADS_PER_HOUR": "20",
    "MAX_BYTES": "20971520",
    // "key": /beta asks for an access key (the private beta). "public": anyone
    // downloads at /download, and /beta redirects there (docs/release.md「公测」).
    "DOWNLOAD_ACCESS": "public",
    // The public download bucket dshgo-dl (releases only), files at
    // <base>download/<version>/<file>, the latest manifest at <base>update.json.
    // The Global button points there once a release's `routes` has dl (else at
    // /download/<version>/<file>). publish-release.sh reads it too; empty: off.
    "DL_BASE_URL": "https://dl.dshtui.com/",
    // The China route: public base URL of the Hong Kong bucket, files at
    // <base><version>/<file>. Empty: not offered. publish-release.sh reads it too.
    "CN_BASE_URL": ""
  },
  // Console logs stay for failures; per-request invocation logs (with request context) are off,
  // so the "no IP in our records" line holds for what we keep (048 review).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}

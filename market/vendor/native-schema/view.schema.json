              "$ref": "#/$defs/binding"
            }
          ]
        },
        "maxDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "$ref": "#/$defs/binding"
            }
          ]
        }
      }
    },

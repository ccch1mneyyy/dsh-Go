  "x-dsh-go": {
    "version": 2,
    "supportedVersions": [1, 2],
    "v2Styles": {
      "fontPixels": {"display": 28, "title": 24, "subtitle": 20, "body": 16, "caption": 13, "mono": 14},
      "spacingPixels": {"S": 8, "M": 12, "L": 16},
      "layout": {
        "preferredContentWidth": 136,
        "textScaleClamp": [1, 2],
        "actionGap": 12,
        "paddingPolicy": "min(requested, max(0, (availableWidth - preferredContentWidth * clampedTextScale) / 2)) on all four sides",
        "narrowPolicy": "Reduce columns and place action buttons vertically when their preferred widths do not fit; never use overflow or clipping to claim larger targets."
      },
      "maxLines": 20,
      "spansPerText": 32,
      "spansPerView": {"toolCard": 64, "panel": 256, "strip": 16},
      "contrast": {

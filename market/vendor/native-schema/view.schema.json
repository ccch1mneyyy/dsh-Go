    "inputV2": {
      "description": "View-v2 input. Panel: editable when bind is present. Tool card: read-only. Strip: unavailable. At most 32 inputs. No password mode.",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string",

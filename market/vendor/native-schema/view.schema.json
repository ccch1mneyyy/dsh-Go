        "action": {
          "type": "object",
          "required": ["label", "action"],
          "properties": {
            "label": { "anyOf": [{ "type": "string", "minLength": 1 }, { "$ref": "#/$defs/binding" }], "description": "Clipped to 12 characters." },
            "icon": { "$ref": "#/$defs/icon" },
            "action": { "$ref": "#/$defs/action" }
          },
          "additionalProperties": false
        }
      }
    },
    "galleryV2": {
      "description": "V2. Pictures in equal cells (2–4 columns; by default 3 from 320 wide, else 2), 8 apart. A cell with an action invokes it; any other tap, and a long press on any cell, opens the app's full-screen viewer on the set, where saving is the app's own action. At most 24 in a panel and 8 in a tool card.",
      "required": ["items"],
      "properties": {
        "items": {
          "anyOf": [

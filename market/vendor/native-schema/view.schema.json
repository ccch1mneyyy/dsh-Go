              "$ref": "#/$defs/binding"
            }
          ]
        },
        "bind": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^data(?:\\.[A-Za-z_][A-Za-z0-9_-]{0,63}){1,16}$",
          "description": "Writable map field path. Reserved prototype names are refused. Duplicate bindings in one view are refused. The bound value wins over value."
        },
        "value": {
          "anyOf": [
            {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]

      "appAccent": "#4B67B4",
      "namedColors": {
        "red": "#D04545",
        "orange": "#CA6328",
        "amber": "#AA7900",
        "green": "#258051",
        "teal": "#167F84",
        "blue": "#3D6FD6",
        "indigo": "#5B5CC7",

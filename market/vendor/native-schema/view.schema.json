                    },
                    "additionalProperties": false
                  },
                  { "$ref": "#/$defs/binding" }
                ]
              }
            },
            { "$ref": "#/$defs/binding" }
          ]
        },
        "columns": { "anyOf": [{ "type": "integer", "minimum": 2, "maximum": 4 }, { "$ref": "#/$defs/binding" }] },
        "aspect": { "anyOf": [{ "type": "number", "minimum": 0.5, "maximum": 2 }, { "$ref": "#/$defs/binding" }], "description": "Width / height of every cell; 1 by default." }
      }
    }

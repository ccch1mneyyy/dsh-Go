        "gap": {"$ref": "#/$defs/spacing"},
        "padding": {"$ref": "#/$defs/spacing", "description": "Requested equal padding on all sides. The renderer reduces all four sides together when the available width cannot preserve the preferred content width."},
        "align": {"$ref": "#/$defs/styleAlign"},
        "background": {"$ref": "#/$defs/color"},
        "columns": {
          "anyOf": [

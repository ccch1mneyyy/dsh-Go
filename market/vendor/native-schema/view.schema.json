        },
        "minLength": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            {
              "$ref": "#/$defs/binding"
            }
          ]
        },
        "maxLength": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            {
              "$ref": "#/$defs/binding"
            }
          ]
        },
        "multiline": {
          "$ref": "#/$defs/flag"
        },
        "maxLines": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            {
              "$ref": "#/$defs/binding"
            }
          ]
        },
        "min": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1000000000000.0,
              "maximum": 1000000000000.0
            },
            {
              "$ref": "#/$defs/binding"
            }
          ]
        },
        "max": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1000000000000.0,
              "maximum": 1000000000000.0
            },
            {
              "$ref": "#/$defs/binding"
            }
          ]
        },
        "step": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 1e-09,
              "maximum": 1000000000000.0
            },
            {
              "$ref": "#/$defs/binding"
            }
          ]
        },
        "range": {
          "$ref": "#/$defs/flag"
        },
        "multi": {
          "$ref": "#/$defs/flag"
        },
        "options": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 24,
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "object",
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "$ref": "#/$defs/binding"
                  }
                ]
              }
            },
            {
              "$ref": "#/$defs/binding"
            }
          ]
        },
        "pattern": {
          "anyOf": [
            {
              "enum": [
                "email",
                "integer",
                "decimal",
                "alphanumeric",
                "slug"
              ]
            },
            {
              "$ref": "#/$defs/binding"
            }
          ]
        },
        "onChange": {
          "$ref": "#/$defs/action"
        },
        "minDate": {
          "anyOf": [

    "emptyStateV2": {
      "description": "V2. The app's own empty look: a round badge in the view's accent, the title, one line, at most one button as wide as its words. In a tool card the button is left out.",
      "required": ["title"],
      "properties": {
        "title": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 40 }, { "$ref": "#/$defs/binding" }] },

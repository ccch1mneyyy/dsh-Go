      "weights": ["regular", "medium", "semibold", "bold"]
    },
    "version2Only": ["textField", "number", "stepper", "toggle", "slider", "select", "segmented", "chips", "date", "time", "rating", "form", "tabs", "collapsible", "accordion", "carousel", "timeline", "grid", "badge", "tag", "avatar", "codeBlock", "divider", "spacer", "emptyState", "gallery"],
    "controlBuilders": ["textField", "number", "stepper", "toggle", "slider", "select", "segmented", "chips", "date", "time", "rating", "form", "tabs", "collapsible", "accordion", "carousel", "timeline", "grid", "badge", "tag", "avatar", "codeBlock", "divider", "spacer", "emptyState", "gallery"],
    "version2Properties": { "metric": ["trend"], "progress": ["shape"] },
    "figureLimits": { "gallery": 24, "galleryCard": 8, "trendPoints": 30 },
    "inputLimits": { "fields": 32, "options": 24, "sections": 8, "timeline": 24, "textLength": 2000, "textLines": 8, "columns": 4, "codeLength": 8000, "valueBytes": 4096,
      "sliderDivisions": 1000, "changeIntervalMs": 250, "queuedRequests": 120 },
    "formulaLimits": { "length": 256, "tokens": 128, "depth": 16 },
    "metaKey": "dsh-go/view",
    "maxJsonNesting": 64,

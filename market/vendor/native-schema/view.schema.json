{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dsh-go plugin view v1 and v2",
  "description": "A native view a DSH plugin hands to the dsh-go phone app: a tree of components from a fixed catalog (the dsh-ui superset), values optionally bound to the view's data model with {\"$\": \"data.path\"}. Used by tool cards (meta[\"dsh-go/view\"]), panels and the composer strip. Strict JSON. Limits JSON Schema cannot express (bytes, node count, depth, children per budget) are listed under x-dsh-go and enforced by the app, which truncates instead of rejecting except for bytes and nesting. Anything the app draws without an issue passes this schema (empty arrays are a legal 'no data yet', long labels are clipped), with three deliberate exceptions where the schema is the stricter author spec: unknown properties (the app ignores them), malformed binding paths (the app shows an em dash) and the alias spellings the app also accepts (success, warning, column, completed, a keyValue 'name'…). Spec: docs/design/native-plugins-views.md.",
  "$ref": "#/$defs/root",
  "$defs": {
    "root": {
      "$ref": "#/$defs/node",
      "description": "The root component. Its title is the tool card's collapsed summary."
    },
    "binding": {
      "description": "A value read from the view's data model. Missing values show as an em dash; arrays that are missing or empty show as 'no data yet'.",
      "type": "object",
      "required": ["$"],
      "properties": {
        "$": {
          "type": "string",
          "pattern": "^data((\\.[^.\\[\\]]+)|(\\[[0-9]+\\])){0,16}$"
        }
      },
      "additionalProperties": false
    },
    "text": {
      "description": "Display text; numbers and booleans are shown as text.",
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "$ref": "#/$defs/binding" },
        { "$ref": "#/$defs/formula" }
      ]
    },
    "label": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "$ref": "#/$defs/binding" },
        { "$ref": "#/$defs/formula" }
      ]
    },
    "number": {
      "anyOf": [
        { "type": "number" },
        { "type": "string", "pattern": "^\\s*[-+]?(\\d[\\d,_]*\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*%?\\s*$" },
        { "type": "null" },
        { "$ref": "#/$defs/binding" },
        { "$ref": "#/$defs/formula" }
      ]
    },
    "flag": {
      "anyOf": [{ "type": "boolean" }, { "$ref": "#/$defs/binding" }]
    },
    "tone": {
      "anyOf": [
        { "enum": ["good", "warn", "bad", "info", "muted"] },
        { "$ref": "#/$defs/binding" }
      ]
    },
    "icon": {
      "description": "A plugin icon name: ui.json's whitelist (app/assets/skills/dsh-go-ui/schema.json) plus the native plugin names (app/lib/plugins/native/native_icons.dart). Unknown names draw a default glyph.",
      "anyOf": [
        {
          "enum": [
            "bolt", "star", "sparkle", "heart", "flag", "bookmark", "pin", "bell", "clock", "alarm",
            "calendar", "todo", "note", "document", "folder", "search", "code", "terminal", "globe", "chart",
            "lightbulb", "book", "puzzle", "robot", "chat", "mail", "translate", "image", "camera", "mic",
            "link", "summary", "wrench", "bug", "travel", "school", "home", "play", "refresh", "archive",
            "team", "wallet", "palette", "coin", "money", "speaker", "read", "copy", "quote", "share",
            "edit", "write", "save", "paste", "add", "remove", "delete", "clear", "fork", "regenerate",
            "reply", "select-text", "qr", "download", "downloads", "external", "info", "warning", "check",
            "done", "success", "error", "question", "pending", "running", "tip", "list", "table", "panel",
            "sidebar", "menu", "more", "expand", "collapse", "file", "folder-open", "workspace", "storage",
            "pdf", "zip", "slides", "article", "text", "diff", "gallery", "audio", "music", "video",
            "video-file", "play-video", "pause", "stop", "replay", "generate-image", "generate-video",
            "diagram", "plugin", "bot", "agent", "skill", "model", "tool", "workflow", "goal", "plan", "job",
            "automation", "command", "trajectory", "web", "web-search", "browser", "history", "time",
            "today", "timezone", "schedule", "repeat", "reminder", "user", "account", "group", "chats",
            "mention", "invite", "announcement", "reaction", "poll", "notification", "send", "community",
            "forum", "feedback", "wechat", "qq", "telegram", "discord", "phone", "computer", "cloud",
            "server", "power", "restart", "retry", "theme", "color", "text-size", "pet", "featured", "badge",
            "favorite", "settings"
          ]
        },
        { "$ref": "#/$defs/binding" }
      ]
    },
    "actionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "action": {
      "description": "Tapping sends an invoke back to the plugin that owns the view. args must stay within 1 KiB after bindings are resolved.",
      "anyOf": [
        { "$ref": "#/$defs/actionId" },
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "$ref": "#/$defs/actionId" },
            "args": { "anyOf": [{ "type": "object" }, { "$ref": "#/$defs/binding" }] }
          },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/binding" }
      ]
    },
    "child": {
      "anyOf": [{ "$ref": "#/$defs/node" }, { "$ref": "#/$defs/binding" }]
    },
    "children": {
      "anyOf": [
        { "type": "array", "items": { "$ref": "#/$defs/child" } },
        { "$ref": "#/$defs/binding" }
      ]
    },
    "list": {
      "description": "An array, or a binding to one.",
      "anyOf": [{ "type": "array" }, { "$ref": "#/$defs/binding" }]
    },
    "node": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "stack", "row", "text", "metric", "chart", "compare", "steps", "callout", "options", "confirm",
            "list", "keyValue", "progress", "table", "actions", "image",
            "textField", "number", "stepper", "toggle", "slider", "select", "segmented", "chips", "date", "time", "rating", "form", "tabs", "collapsible", "accordion", "carousel", "timeline", "grid", "badge", "tag", "avatar", "codeBlock", "divider", "spacer", "emptyState", "gallery"
          ]
        },
        "title": { "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/binding" }], "description": "Read on the root only; clipped to 80 characters." },
        "v": {"enum": [1, 2], "description": "Read on the root only. Omitted or 1 preserves the v1 rendering path; 2 enables bounded styles and controls."},
        "accent": {"$ref": "#/$defs/accent", "description": "V2 only; root only. Named or #RRGGBB accent, or \"app\" for the person's own palette; corrected separately against each painted background."}
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "stack" } } }, "then": { "$ref": "#/$defs/layout" } },
        { "if": { "properties": { "type": { "const": "row" } } }, "then": { "$ref": "#/$defs/layout" } },
        { "if": { "properties": { "type": { "const": "text" } } }, "then": { "$ref": "#/$defs/textNode" } },
        { "if": { "properties": { "type": { "const": "metric" } } }, "then": { "$ref": "#/$defs/metric" } },
        { "if": { "properties": { "type": { "const": "chart" } } }, "then": { "$ref": "#/$defs/chart" } },
        { "if": { "properties": { "type": { "const": "compare" } } }, "then": { "$ref": "#/$defs/compare" } },
        { "if": { "properties": { "type": { "const": "steps" } } }, "then": { "$ref": "#/$defs/steps" } },
        { "if": { "properties": { "type": { "const": "callout" } } }, "then": { "$ref": "#/$defs/callout" } },
        { "if": { "properties": { "type": { "const": "options" } } }, "then": { "$ref": "#/$defs/options" } },
        { "if": { "properties": { "type": { "const": "confirm" } } }, "then": { "$ref": "#/$defs/confirm" } },
        { "if": { "properties": { "type": { "const": "list" } } }, "then": { "$ref": "#/$defs/listNode" } },
        { "if": { "properties": { "type": { "const": "keyValue" } } }, "then": { "$ref": "#/$defs/keyValue" } },
        { "if": { "properties": { "type": { "const": "progress" } } }, "then": { "$ref": "#/$defs/progress" } },
        { "if": { "properties": { "type": { "const": "table" } } }, "then": { "$ref": "#/$defs/table" } },
        { "if": { "properties": { "type": { "const": "actions" } } }, "then": { "$ref": "#/$defs/actions" } },
        { "if": { "properties": { "type": { "const": "image" } } }, "then": { "$ref": "#/$defs/image" } },
        { "if": { "properties": { "type": { "const": "textField" } } }, "then": { "$ref": "#/$defs/inputV2" } },
        { "if": { "properties": { "type": { "const": "number" } } }, "then": { "$ref": "#/$defs/inputV2" } },
        { "if": { "properties": { "type": { "const": "stepper" } } }, "then": { "$ref": "#/$defs/inputV2" } },
        { "if": { "properties": { "type": { "const": "toggle" } } }, "then": { "$ref": "#/$defs/inputV2" } },
        { "if": { "properties": { "type": { "const": "slider" } } }, "then": { "$ref": "#/$defs/inputV2" } },
        { "if": { "properties": { "type": { "const": "select" } } }, "then": { "$ref": "#/$defs/inputV2" } },
        { "if": { "properties": { "type": { "const": "segmented" } } }, "then": { "$ref": "#/$defs/inputV2" } },
        { "if": { "properties": { "type": { "const": "chips" } } }, "then": { "$ref": "#/$defs/inputV2" } },
        { "if": { "properties": { "type": { "const": "date" } } }, "then": { "$ref": "#/$defs/inputV2" } },
        { "if": { "properties": { "type": { "const": "time" } } }, "then": { "$ref": "#/$defs/inputV2" } },
        { "if": { "properties": { "type": { "const": "rating" } } }, "then": { "$ref": "#/$defs/inputV2" } },
        { "if": { "properties": { "type": { "const": "form" } } }, "then": { "$ref": "#/$defs/formV2" } },
        { "if": { "properties": { "type": { "const": "tabs" } } }, "then": { "$ref": "#/$defs/sectionsV2" } },
        { "if": { "properties": { "type": { "const": "collapsible" } } }, "then": { "$ref": "#/$defs/containerV2" } },
        { "if": { "properties": { "type": { "const": "accordion" } } }, "then": { "$ref": "#/$defs/sectionsV2" } },
        { "if": { "properties": { "type": { "const": "carousel" } } }, "then": { "$ref": "#/$defs/sectionsV2" } },
        { "if": { "properties": { "type": { "const": "timeline" } } }, "then": { "$ref": "#/$defs/sectionsV2" } },
        { "if": { "properties": { "type": { "const": "grid" } } }, "then": { "$ref": "#/$defs/containerV2" } },
        { "if": { "properties": { "type": { "const": "badge" } } }, "then": { "$ref": "#/$defs/badgeV2" } },
        { "if": { "properties": { "type": { "const": "tag" } } }, "then": { "$ref": "#/$defs/badgeV2" } },
        { "if": { "properties": { "type": { "const": "avatar" } } }, "then": { "$ref": "#/$defs/image" } },
        { "if": { "properties": { "type": { "const": "codeBlock" } } }, "then": { "$ref": "#/$defs/codeV2" } },
        { "if": { "properties": { "type": { "const": "divider" } } }, "then": { "$ref": "#/$defs/spaceV2" } },
        { "if": { "properties": { "type": { "const": "spacer" } } }, "then": { "$ref": "#/$defs/spaceV2" } },
        { "if": { "properties": { "type": { "const": "emptyState" } } }, "then": { "$ref": "#/$defs/emptyStateV2" } },
        { "if": { "properties": { "type": { "const": "gallery" } } }, "then": { "$ref": "#/$defs/galleryV2" } }
      ],
      "unevaluatedProperties": false
    },
    "layout": {
      "required": ["children"],
      "properties": {"children": {"$ref": "#/$defs/children"}, "style": {"anyOf": [{"$ref": "#/$defs/layoutStyle"}, {"$ref": "#/$defs/binding"}]}}
    },
    "textNode": {
      "required": ["text"],
      "properties": {
        "text": {"$ref": "#/$defs/text"},
        "tone": {"anyOf": [{"const": "muted"}, {"$ref": "#/$defs/binding"}]},
        "style": {"anyOf": [{"$ref": "#/$defs/textStyle"}, {"$ref": "#/$defs/binding"}]},
        "spans": {
          "$ref": "#/$defs/richSpans",
          "description": "V2 inline runs. Keep text as the plain v1 fallback; links remain invoke effects."
        }
      }
    },
    "metric": {
      "required": ["label", "value"],
      "properties": {
        "label": {"$ref": "#/$defs/label"},
        "value": {"$ref": "#/$defs/label"},
        "tone": {"$ref": "#/$defs/tone"},
        "caption": {"$ref": "#/$defs/label"},
        "style": {"anyOf": [{"$ref": "#/$defs/textStyle"}, {"$ref": "#/$defs/binding"}]},
        "trend": {
          "description": "V2 only. A small line under the value: 2–30 numbers, at least two of them finite; null breaks the line. No axes, no numbers; an older app ignores it.",
          "anyOf": [
            { "type": "array", "minItems": 2, "maxItems": 30, "items": { "anyOf": [{ "type": "number" }, { "type": "null" }, { "$ref": "#/$defs/binding" }] } },
            { "$ref": "#/$defs/binding" }
          ]
        }
      }
    },
    "chart": {
      "required": ["categories", "series"],
      "properties": {
        "kind": { "anyOf": [{ "enum": ["bar", "hbar", "line", "donut"] }, { "$ref": "#/$defs/binding" }] },
        "categories": {
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/$defs/text" } },
            { "$ref": "#/$defs/binding" }
          ]
        },
        "series": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": ["values"],
                    "properties": {
                      "name": { "$ref": "#/$defs/text" },
                      "values": {
                        "anyOf": [
                          { "type": "array", "items": { "$ref": "#/$defs/number" } },
                          { "$ref": "#/$defs/binding" }
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  { "$ref": "#/$defs/binding" }
                ]
              }
            },
            { "$ref": "#/$defs/binding" }
          ]
        },
        "unit": { "$ref": "#/$defs/text" },
        "caption": { "$ref": "#/$defs/label" }
      }
    },
    "compare": {
      "required": ["items"],
      "properties": {
        "items": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": ["title"],
                    "properties": {
                      "title": { "$ref": "#/$defs/text" },
                      "badge": { "$ref": "#/$defs/text" },
                      "rows": {
                        "anyOf": [
                          { "type": "array", "items": { "anyOf": [{ "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, { "$ref": "#/$defs/binding" }] } },
                          { "type": "object", "additionalProperties": { "$ref": "#/$defs/text" } },
                          { "$ref": "#/$defs/binding" }
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  { "$ref": "#/$defs/binding" }
                ]
              }
            },
            { "$ref": "#/$defs/binding" }
          ]
        }
      }
    },
    "steps": {
      "required": ["items"],
      "properties": {
        "items": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "required": ["label"],
                    "properties": {
                      "label": { "$ref": "#/$defs/label" },
                      "status": { "anyOf": [{ "enum": ["done", "current", "todo", "failed"] }, { "$ref": "#/$defs/binding" }] },
                      "detail": { "$ref": "#/$defs/label" }
                    },
                    "additionalProperties": false
                  },
                  { "$ref": "#/$defs/binding" }
                ]
              }
            },
            { "$ref": "#/$defs/binding" }
          ]
        }
      }
    },
    "callout": {
      "required": ["text"],
      "properties": {
        "text": {"$ref": "#/$defs/text"},
        "tone": {"anyOf": [{"enum": ["info", "good", "warn", "bad"]}, {"$ref": "#/$defs/binding"}]},
        "style": {"anyOf": [{"$ref": "#/$defs/textStyle"}, {"$ref": "#/$defs/binding"}]}
      }
    },
    "options": {
      "required": ["id", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/actionId" },
        "multi": { "$ref": "#/$defs/flag" },
        "selected": {
          "anyOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } },
            { "type": "null" },
            { "$ref": "#/$defs/binding" }
          ]
        },
        "options": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "required": ["label"],
                    "properties": {
                      "label": { "$ref": "#/$defs/text" },
                      "description": { "$ref": "#/$defs/label" },
                      "value": { "type": "string" }
                    },
                    "additionalProperties": false
                  },
                  { "$ref": "#/$defs/binding" }
                ]
              }
            },
            { "$ref": "#/$defs/binding" }
          ]
        }
      }
    },
    "confirm": {
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/actionId" },
        "confirmLabel": { "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/binding" }], "description": "Clipped to 12 characters." },
        "cancelLabel": { "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/binding" }], "description": "Clipped to 12 characters." }
      }
    },
    "listNode": {
      "required": ["items"],
      "properties": {
        "items": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": ["title"],
                    "properties": {
                      "title": { "$ref": "#/$defs/label" },
                      "subtitle": { "$ref": "#/$defs/label" },
                      "trailing": { "$ref": "#/$defs/label" },
                      "icon": { "$ref": "#/$defs/icon" },
                      "tone": { "$ref": "#/$defs/tone" },
                      "action": { "$ref": "#/$defs/action" }
                    },
                    "additionalProperties": false
                  },
                  { "$ref": "#/$defs/binding" }
                ]
              }
            },
            { "$ref": "#/$defs/binding" }
          ]
        }
      }
    },
    "keyValue": {
      "required": ["items"],
      "properties": {
        "items": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/label" } },
                  {
                    "type": "object",
                    "required": ["label"],
                    "properties": {
                      "label": { "$ref": "#/$defs/label" },
                      "value": { "$ref": "#/$defs/label" },
                      "tone": { "$ref": "#/$defs/tone" }
                    },
                    "additionalProperties": false
                  },
                  { "$ref": "#/$defs/binding" }
                ]
              }
            },
            { "type": "object", "additionalProperties": { "$ref": "#/$defs/label" } },
            { "$ref": "#/$defs/binding" }
          ]
        }
      }
    },
    "progress": {
      "required": ["value"],
      "properties": {
        "value": { "$ref": "#/$defs/number" },
        "max": { "$ref": "#/$defs/number" },
        "label": { "$ref": "#/$defs/label" },
        "caption": { "$ref": "#/$defs/label" },
        "tone": { "$ref": "#/$defs/tone" },
        "shape": {
          "description": "V2 only. \"ring\": 64 across with the figure in the middle and the label under it. An older app draws the bar.",
          "anyOf": [{ "enum": ["bar", "ring"] }, { "$ref": "#/$defs/binding" }]
        }
      }
    },
    "table": {
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "anyOf": [
                  { "$ref": "#/$defs/label" },
                  {
                    "type": "object",
                    "required": ["label"],
                    "properties": {
                      "label": { "$ref": "#/$defs/label" },
                      "align": { "enum": ["start", "end"] }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            { "$ref": "#/$defs/binding" }
          ]
        },
        "rows": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "array", "items": { "anyOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] } },
                  { "$ref": "#/$defs/binding" }
                ]
              }
            },
            { "$ref": "#/$defs/binding" }
          ]
        }
      }
    },
    "actions": {
      "required": ["items"],
      "properties": {
        "items": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": ["label", "action"],
                    "properties": {
                      "label": { "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/binding" }], "description": "Clipped to 24 characters." },
                      "icon": { "$ref": "#/$defs/icon" },
                      "style": { "enum": ["primary", "plain"] },
                      "action": { "$ref": "#/$defs/action" }
                    },
                    "additionalProperties": false
                  },
                  { "$ref": "#/$defs/binding" }
                ]
              }
            },
            { "$ref": "#/$defs/binding" }
          ]
        }
      }
    },
    "imageSource": {
      "description": "A file in the manifest's assets directory (asset:…) or a data: URL of at most 64 KiB. Web addresses draw a placeholder.",
      "anyOf": [
        { "type": "string", "maxLength": 65536, "pattern": "^data:image/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/=\\s]+$" },
        { "type": "string", "maxLength": 512, "pattern": "^asset:[A-Za-z0-9_~-][A-Za-z0-9._~-]*(/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)*\\.([Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg]|[Ww][Ee][Bb][Pp]|[Gg][Ii][Ff])$" },
        { "$ref": "#/$defs/binding" }
      ]
    },
    "image": {
      "required": ["src"],
      "properties": {
        "src": { "$ref": "#/$defs/imageSource" },
        "alt": { "$ref": "#/$defs/label" },
        "aspect": { "anyOf": [{ "type": "number", "minimum": 0.25, "maximum": 4 }, { "$ref": "#/$defs/binding" }] },
        "caption": { "$ref": "#/$defs/label" }
      }
    },
    "color": {
      "anyOf": [
        {"enum": ["accent", "red", "orange", "amber", "green", "teal", "blue", "indigo", "violet", "pink", "gray"]},
        {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        {"$ref": "#/$defs/binding"}
      ],
      "description": "Opaque sRGB only. The app derives light/dark colours and corrects text contrast."
    },
    "textSize": {"anyOf": [{"enum": ["display", "title", "subtitle", "body", "caption", "mono"]}, {"$ref": "#/$defs/binding"}]},
    "textWeight": {"anyOf": [{"enum": ["regular", "medium", "semibold", "bold"]}, {"$ref": "#/$defs/binding"}]},
    "styleAlign": {"anyOf": [{"enum": ["start", "center", "end"]}, {"$ref": "#/$defs/binding"}]},
    "spacing": {"anyOf": [{"enum": ["S", "M", "L"]}, {"$ref": "#/$defs/binding"}]},
    "textStyle": {
      "type": "object",
      "properties": {

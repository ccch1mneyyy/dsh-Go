{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go.dshtui.com/schemas/workshop-v1.json",
  "title": "DSH Go Workshop catalog v1",
  "type": "object",
  "required": ["schema", "generatedAt", "features", "entries", "withdrawn"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "features": {"type": "object", "required": ["uploads", "companion"], "additionalProperties": false, "properties": {"uploads": {"type": "boolean"}, "companion": {"type": "boolean"}}},
    "entries": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/entry"}},
    "withdrawn": {"type": "array", "maxItems": 4000, "items": {"$ref": "#/$defs/withdrawal"}}
  },
  "$defs": {
    "kind": {"enum": ["pet", "companion"], "$comment": "New capability kinds extend this enum and add a validator; existing entry shapes remain unchanged. Unknown kinds must be ignored by older clients, never interpreted as pet."},
    "id": {"type": "string", "maxLength": 40, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "not": {"pattern": "[\\r\\n]"}},
    "version": {"type": "string", "maxLength": 80, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$", "not": {"pattern": "[\\r\\n]"}},
    "text": {"type": "string", "minLength": 1, "not": {"pattern": "[\u0000-\u001f]"}},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "version", "minApp", "title", "author", "license", "source", "url", "sha256", "size", "blockedVersions"],
      "properties": {
        "kind": {"$ref": "#/$defs/kind"}, "id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "minApp": {"$ref": "#/$defs/version"},
        "title": {"type": "object", "additionalProperties": false, "required": ["zh", "en"], "properties": {"zh": {"$ref": "#/$defs/text", "maxLength": 120}, "en": {"$ref": "#/$defs/text", "maxLength": 120}}},
        "author": {"$ref": "#/$defs/text", "maxLength": 256},
        "description": {"type": "string", "maxLength": 512, "anyOf": [{"const": ""}, {"$ref": "#/$defs/text", "not": {"pattern": "^[\\s\\u0085]*$"}}]},
        "tags": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/text", "maxLength": 32, "not": {"pattern": "^[\\s\\u0085]*$"}}},
        "license": {"enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0", "MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "LicenseRef-Author-Permission"]},
        "source": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^[hH][tT][tT][pP][sS]://"},
        "url": {"type": "string", "pattern": "^/market/workshop/(pet|companion)/[^/]+/[^/]+/[a-f0-9]{64}\\.zip$"},
        "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 1, "maximum": 20971520},
        "blockedVersions": {"type": "array", "uniqueItems": true, "maxItems": 4000, "items": {"$ref": "#/$defs/version"}}
      }
    },
    "withdrawal": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "version", "reason", "at"],
      "properties": {"kind": {"$ref": "#/$defs/kind"}, "id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "reason": {"$ref": "#/$defs/text", "maxLength": 2000}, "at": {"type": "string", "format": "date-time"}}
    }
  },
  "$comment": "Worker validation additionally enforces exact URL/id/version/SHA binding, HTTPS with no credentials, Unicode scalar/control checks, per-kind identity uniqueness, permanent blocked-version history, and nonblank text. JSON Schema alone is not publication authority."
}

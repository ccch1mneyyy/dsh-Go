+#ifndef DSH_FAKEFS_READONLY_H
+#define DSH_FAKEFS_READONLY_H
+#include "kernel/fs.h"
+#include "kernel/calls.h"
+// Only the confined embedding activates this bit per serialized guest job.
+// No writable job survives the transition; existing FDs are checked as well.
+static inline bool fakefs_mount_readonly(const struct mount *mount) {
+#ifdef DSH_IOS_GUEST_CONFINED
+    return mount && mount->fs == &fakefs && (mount->flags & MS_READONLY_);
+#else
+    (void)mount;
+    return false;
+#endif
+}

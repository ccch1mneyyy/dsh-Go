--- a/kernel/signal.c
+++ b/kernel/signal.c
@@ -59,6 +59,11 @@
 // duplicate as "already pending" loses a resume and wedges the GC handshake.
 #define SIGRTMIN_ 32
 static void deliver_signal_unlocked(struct task *task, int sig, struct siginfo_ info) {
+#ifdef DSH_IOS_GUEST_CONFINED
+    // The embedding's PID1 is a host-owned bookkeeping supervisor, not a
+    // runnable guest pthread. Never pthread_kill an unset/reused host identity.
+    if (task->pid == 1 && task->dsh_job_id == 0) return;
+#endif
     if (sig < SIGRTMIN_ && sigset_has(task->pending, sig))
         return;
 

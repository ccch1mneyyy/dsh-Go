+// DSH portability for the Linux build verification target.
+#if defined(__linux__)
+#define st_atimespec st_atim
+#define st_mtimespec st_mtim
+#define st_ctimespec st_ctim
+#endif
+static int dsh_fd_path(int fd, char path[PATH_MAX]) {
+#ifdef __APPLE__
+    return fcntl(fd, F_GETPATH, path);
+#else
+    char link[64];
+    snprintf(link, sizeof(link), "/proc/self/fd/%d", fd);
+    ssize_t size = readlink(link, path, PATH_MAX - 1);
+    if (size < 0) return -1;
+    if (size == PATH_MAX - 1) { errno = ENAMETOOLONG; return -1; }
+    path[size] = 0;
+    return 0;
+#endif
+}
 

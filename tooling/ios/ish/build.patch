+#!/bin/bash
+set -euo pipefail
+# DSH: preserve SDK/source paths containing spaces and propagate compiler errors.
+python3 - "$@" <<'PYTHON'
+import json, pathlib, re, shlex, subprocess, sys
+commands_path, source, output, dep = sys.argv[1:]
+commands = json.loads(pathlib.Path(commands_path).read_text())
+command = next(c for c in commands if c['file'].endswith('asbestos/asbestos.c'))
+args = shlex.split(command['command'])
+flags = []
+i = 0
+while i < len(args):
+    arg = args[i]
+    if arg in ('-o', '-MF', '-MQ', '-MT'):
+        i += 2
+        continue
+    if arg in ('-c', '-MD', '-MMD') or arg == command['file']:
+        i += 1
+        continue
+    flags.append(arg)
+    i += 1
+text = subprocess.check_output(flags + ['-MD', '-MQ', output, '-MF', dep,
+    source, '-include', str(pathlib.Path(source).parent.parent / 'tools/staticdefine.h'),
+    '-S', '-o', '-'], text=True, cwd=command['directory'])
+lines = []
+for line in text.splitlines():
+    match = re.match(r'\s*\.ascii\s+"(.*)"', line)
+    if match:
+        line = match[1]
+    if not line.startswith('->'):
+        continue
+    if line.startswith('->#'):
+        lines.append('/* ' + line[3:] + ' */')
+    elif line == '->':
+        lines.append('')
+    else:
+        match = re.match(r'->([^ ]+) [\$#]*([^ ]+) (.*)', line)
+        if match:
+            lines.append('#define ' + match[1] + ' ' + match[2] + ' /* ' + match[3] + ' */')
+pathlib.Path(output).write_text('\n'.join(lines) + '\n')
+PYTHON

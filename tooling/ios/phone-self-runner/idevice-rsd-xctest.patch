+    /// Sends exactly once with a cap on all received HTTP bytes (headers,
+    /// framing, trailers and body) and one deadline covering DNS, connection,
+    /// TLS, request write and response read. Does not follow redirects, so a
+    /// sensitive POST cannot move to another authority or downgrade to HTTP.
+    pub async fn send_bounded(
+        self,
+        maximum_response: usize,
+        deadline: std::time::Duration,
+    ) -> Result<HttpResponse, IdeviceError> {
+        if maximum_response == 0 || deadline.is_zero() {
+            return Err(IdeviceError::Http("invalid HTTP response budget".into()));
+        }
+        response_deadline(
+            deadline,
+            send_once(self.method, &self.url, &self.headers, &self.body, Some(maximum_response)),
+        ).await
+    }
+}
+
+async fn response_deadline<T>(
+    deadline: std::time::Duration,
+    operation: impl std::future::Future<Output = Result<T, IdeviceError>>,
+) -> Result<T, IdeviceError> {
+    tokio::time::timeout(deadline, operation).await
+        .map_err(|_| IdeviceError::Http("HTTP request deadline exceeded".into()))?
 }


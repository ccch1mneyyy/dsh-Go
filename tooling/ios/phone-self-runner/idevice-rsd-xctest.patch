+#[cfg(test)]
+mod dsh_tss_bounds_tests {
+    use super::*;
+    use std::time::Duration;
+
+    async fn response(bytes: &[u8], maximum: usize) -> Result<HttpResponse, IdeviceError> {
+        // Memory-only transport: there is no socket, DNS, server or TSS request.
+        let (mut writer, reader) = tokio::io::duplex(bytes.len() + 1);
+        writer.write_all(bytes).await.unwrap();
+        drop(writer);
+        let mut stream: Box<dyn ReadWrite> = Box::new(reader);
+        read_response(&mut stream, Some(maximum)).await
+    }
+
+    #[tokio::test]
+    async fn exact_wire_limit_and_one_byte_over() {
+        let wire = b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello";
+        assert_eq!(response(wire, wire.len()).await.unwrap().body, b"hello");
+        assert!(response(wire, wire.len() - 1).await.is_err());
+    }
+
+    #[tokio::test]
+    async fn declared_length_overflow_and_truncation_are_errors() {
+        for wire in [
+            format!("HTTP/1.1 200 OK\r\nContent-Length: {}\r\n\r\n", usize::MAX),
+            "HTTP/1.1 200 OK\r\nContent-Length: 1048577\r\n\r\n".into(),
+            "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhey".into(),
+        ] {
+            assert!(response(wire.as_bytes(), 1024 * 1024).await.is_err());
+        }
+    }
+
+    #[tokio::test]
+    async fn eof_body_is_bounded_including_headers() {
+        let wire = b"HTTP/1.1 200 OK\r\n\r\nhello";
+        assert_eq!(response(wire, wire.len()).await.unwrap().body, b"hello");
+        assert!(response(wire, wire.len() - 1).await.is_err());
+    }
+
+    #[tokio::test]
+    async fn chunked_total_includes_framing_and_requires_terminal() {
+        let wire = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nhe\r\n3\r\nllo\r\n0\r\n\r\n";
+        assert_eq!(response(wire, wire.len()).await.unwrap().body, b"hello");
+        assert!(response(wire, wire.len() - 1).await.is_err());
+        assert!(response(&wire[..wire.len() - 2], wire.len()).await.is_err());
+        let overflow = format!("{:x}\r\n", usize::MAX);
+        assert!(decode_chunked(overflow.as_bytes()).is_err());
+    }
+
+    #[tokio::test]
+    async fn headers_have_a_separate_small_limit() {
+        let wire = format!("HTTP/1.1 200 OK\r\nX-Large: {}\r\nContent-Length: 0\r\n\r\n", "a".repeat(MAX_BOUNDED_HEAD));
+        let error = response(wire.as_bytes(), 1024 * 1024).await.unwrap_err();
+        assert!(error.to_string().contains("headers exceed limit"));
+    }
+
+    #[tokio::test]
+    async fn ambiguous_or_invalid_framing_is_rejected() {
+        for headers in [
+            "Content-Length: 0\r\nContent-Length: 0",
+            "Transfer-Encoding: chunked\r\nContent-Length: 0",
+            "Transfer-Encoding: chunked\r\nTransfer-Encoding: chunked",
+            "Transfer-Encoding: gzip, chunked",
+            "Content-Length: -1",
+            "Content-Length: invalid",
+        ] {
+            let wire = format!("HTTP/1.1 200 OK\r\n{headers}\r\n\r\n0\r\n\r\n");
+            assert!(response(wire.as_bytes(), 1024).await.is_err(), "{headers}");
+        }
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn whole_operation_uses_one_deadline() {
+        let started = tokio::time::Instant::now();
+        let result: Result<(), IdeviceError> = response_deadline(Duration::from_secs(30), async {
+            // Independent phases cannot each restart the 30-second budget.
+            tokio::time::sleep(Duration::from_secs(20)).await;
+            tokio::time::sleep(Duration::from_secs(20)).await;
+            Ok(())
+        }).await;
+        assert!(result.unwrap_err().to_string().contains("deadline exceeded"));
+        assert_eq!(started.elapsed(), Duration::from_secs(30));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn stalled_read_timeout_drops_the_owned_stream() {
+        let (mut peer, reader) = tokio::io::duplex(16);
+        let result = response_deadline(Duration::from_secs(30), async move {
+            let mut stream: Box<dyn ReadWrite> = Box::new(reader);
+            read_response(&mut stream, Some(1024)).await
+        }).await;
+        assert!(result.unwrap_err().to_string().contains("deadline exceeded"));
+        // The timeout cancels the operation by dropping its stream owner.
+        assert!(peer.write_all(b"x").await.is_err());
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn operation_within_deadline_succeeds() {
+        let result = response_deadline(Duration::from_secs(30), async {
+            tokio::time::sleep(Duration::from_secs(29)).await;
+            response(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok", 128).await
+        }).await.unwrap();
+        assert_eq!(result.body, b"ok");
+    }
+}

new file mode 100644
--- /dev/null
+++ b/idevice/src/xpc/bounds.rs
@@ -0,0 +1,81 @@
+//! Local control-message limits. File-transfer data is a separate stream path.
+use crate::IdeviceError;
+
+pub(super) const XPC_WRAPPER_LEN: usize = 24;
+pub(super) const MAX_XPC_BODY: usize = 16 * 1024 * 1024;
+pub(super) const MAX_BUFFERED_XPC: usize = XPC_WRAPPER_LEN + MAX_XPC_BODY;
+
+fn limit_error() -> IdeviceError {
+    IdeviceError::UnexpectedResponse("RemoteXPC control message exceeds limit".into())
+}
+
+/// Check the u64 declaration as soon as bytes 8..16 exist. No allocation or
+/// unchecked integer conversion/addition is based on a peer's declaration.
+pub(super) fn frame_len(bytes: &[u8]) -> Result<Option<usize>, IdeviceError> {
+    if bytes.len() < 16 { return Ok(None); }
+    let body = u64::from_le_bytes([
+        bytes[8], bytes[9], bytes[10], bytes[11], bytes[12], bytes[13], bytes[14], bytes[15],
+    ]);
+    if body > MAX_XPC_BODY as u64 { return Err(limit_error()); }
+    let body = usize::try_from(body).map_err(|_| limit_error())?;
+    body.checked_add(XPC_WRAPPER_LEN).map(Some).ok_or_else(limit_error)
+}
+
+/// A channel's whole pending buffer also has a cap, including coalesced messages
+/// and incomplete headers. Reject before extending the Vec.
+pub(super) fn append(buffer: &mut Vec<u8>, chunk: &[u8]) -> Result<(), IdeviceError> {
+    if buffer.len().checked_add(chunk.len()).is_none_or(|size| size > MAX_BUFFERED_XPC) {
+        return Err(limit_error());
+    }
+    let existing = buffer.len().min(16);
+    let added = chunk.len().min(16 - existing);
+    if existing + added == 16 {
+        let mut prefix = [0u8; 16];
+        prefix[..existing].copy_from_slice(&buffer[..existing]);
+        prefix[existing..existing + added].copy_from_slice(&chunk[..added]);
+        frame_len(&prefix)?;
+    }
+    buffer.extend_from_slice(chunk);
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn header(body: u64) -> Vec<u8> {
+        let mut bytes = vec![0; XPC_WRAPPER_LEN];
+        bytes[..4].copy_from_slice(&0x29b00b92u32.to_le_bytes());
+        bytes[8..16].copy_from_slice(&body.to_le_bytes());
+        bytes
+    }
+
+    #[test]
+    fn declaration_accepts_exact_limit_and_rejects_overflow() {
+        assert_eq!(frame_len(&header(0)).unwrap(), Some(XPC_WRAPPER_LEN));
+        assert_eq!(frame_len(&header(MAX_XPC_BODY as u64)).unwrap(), Some(MAX_BUFFERED_XPC));
+        assert!(frame_len(&header(MAX_XPC_BODY as u64 + 1)).is_err());
+        assert!(frame_len(&header(u64::MAX)).is_err());
+    }
+
+    #[test]
+    fn split_length_is_rejected_before_the_buffer_grows() {
+        let bytes = header(u64::MAX);
+        let mut buffer = bytes[..15].to_vec();
+        let before = buffer.clone();
+        assert!(append(&mut buffer, &bytes[15..]).is_err());
+        assert_eq!(buffer, before);
+        assert_eq!(frame_len(&bytes[..15]).unwrap(), None);
+    }
+
+    #[test]
+    fn pending_buffer_exact_cap_is_accepted_then_one_more_byte_is_rejected() {
+        let mut buffer = vec![0; MAX_BUFFERED_XPC];
+        buffer[..XPC_WRAPPER_LEN].copy_from_slice(&header(MAX_XPC_BODY as u64));
+        assert!(append(&mut buffer, &[]).is_ok());
+        let capacity = buffer.capacity();
+        assert!(append(&mut buffer, &[0]).is_err());
+        assert_eq!(buffer.len(), MAX_BUFFERED_XPC);
+        assert_eq!(buffer.capacity(), capacity);
+    }
+}

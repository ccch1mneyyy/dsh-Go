+    assert!(client.streams.contains_key(&7)); // Unconsumed final data stays available.
+    assert_eq!(client.read(7).await.unwrap(), vec![7; 2]);
+    assert!(!client.streams.contains_key(&7));
+    client.send_end_stream(Vec::new(), 9).await.unwrap();
+    input(&state, &wire(1, 5, 9, &[])); // END_HEADERS | END_STREAM.
+    client.pump().await.unwrap();
+    assert!(!client.streams.contains_key(&9));
+    client.cache_data(data(11, 0, true)).unwrap();
+    assert_eq!(client.read(11).await.unwrap(), Vec::<u8>::new());

+/// Run an already authenticated RPPairing/RSD tunnel without a USB/lockdown host.
+/// DSH addition: keep the original session helpers and launch only the requested
+/// signed runner. Cancellation kills only the PID returned by this launch.
+pub async fn run_rsd<L: XCUITestListener>(
+    mut handle: crate::tcp::handle::AdapterHandle,
+    handshake: RsdHandshake,
+    cfg: TestConfig,
+    ios_major_version: u8,
+    listener: &mut L,
+    mut cancel: tokio::sync::watch::Receiver<bool>,
+) -> Result<(), IdeviceError> {
+    if ios_major_version < 17 {
+        return Err(IdeviceError::ServiceNotFound);
+    }
+    let connections = async {
+        listener.bootstrap_stage("CONNECT_DVT");
+        let dvt = rsd_connect(&mut handle, &handshake, "com.apple.instruments.dtservicehub", "dsh-dvt", true).await?;
+        listener.bootstrap_stage("CONNECT_CONTROL");
+        let ctrl = rsd_connect(&mut handle, &handshake, TESTMANAGERD_RSD_SERVICE, "dsh-ctrl", false).await?;
+        listener.bootstrap_stage("CONNECT_MAIN");
+        let main = rsd_connect(&mut handle, &handshake, TESTMANAGERD_RSD_SERVICE, "dsh-main", false).await?;
+        Ok::<_, IdeviceError>(TestManagerConnections { ctrl, main, dvt, rsd_handles: vec![handle] })
+    };
+    let Some(mut conns) = run_rsd_prelaunch(&mut cancel, std::time::Duration::from_secs(90), connections).await?
+        else { return Ok(()); };
+    let session_id = uuid::Uuid::new_v4();
+    let xctest_path = format!("/tmp/{}.xctestconfiguration", session_id.to_string().to_uppercase());
+    let xctest_config = cfg.build_xctest_configuration(session_id, ios_major_version)?;
+    let initialize = async {
+        listener.bootstrap_stage("OPEN_CONTROL_PROXY");
+        let mut ctrl = TestManagerProxy::open(&mut conns.ctrl, ios_major_version).await?;
+        listener.bootstrap_stage("OPEN_MAIN_PROXY");
+        let mut main = TestManagerProxy::open(&mut conns.main, ios_major_version).await?;
+        listener.bootstrap_stage("INITIALIZE_SESSIONS");
+        initialize_testmanager_sessions(&mut ctrl, &mut main, &xctest_config).await?;
+        listener.bootstrap_stage("REGISTER_DRIVER");
+        register_early_driver_channel_handler(&mut conns.main, &xctest_config).await;
+        listener.bootstrap_stage("INITIALIZE_DAEMONS");
+        initialize_testmanager_daemon_sessions(&mut ctrl, &mut main, ios_major_version,
+                                              &session_id, &xctest_config).await?;
+        Ok::<_, IdeviceError>((ctrl, main))
+    };
+    let Some((mut ctrl_proxy, mut main_proxy)) = run_rsd_prelaunch(&mut cancel,
+        std::time::Duration::from_secs(90), initialize).await? else { return Ok(()); };
+    listener.bootstrap_stage("OPEN_PROCESS_CONTROL");
+    let Some(mut process_control) = run_rsd_prelaunch(&mut cancel,
+        std::time::Duration::from_secs(10), XCTestProcessControlChannel::open(&mut conns.dvt)).await?
+        else { return Ok(()); };
+    if *cancel.borrow() { return Ok(()); }
+    let (launch_args, launch_env, launch_options) = build_launch_env(
+        ios_major_version, &session_id, &cfg.runner_app_path, &cfg.runner_app_container,
+        cfg.config_name(), &xctest_path, cfg.runner_env.as_ref(), cfg.runner_args.as_deref());
+    // Once launch is sent, retain the owner until it yields a PID or an error.
+    // Do not cancel a partially sent launch then let a new owner race its cleanup.
+    listener.bootstrap_stage("LAUNCH_RUNNER");
+    let pid = run_rsd_launch(std::time::Duration::from_secs(30),
+        process_control.launch_suspended_process(&cfg.runner_bundle_id, launch_args,
+                                                launch_env, launch_options)).await?;
+    listener.bootstrap_stage("RUNNER_LAUNCHED");
+    let execution = async {
+        listener.bootstrap_stage("AUTHORIZE_RUNNER");
+        ctrl_proxy.authorize_test(ios_major_version, pid).await?;
+        listener.bootstrap_stage("START_TEST_PLAN");
+        let driver = start_test_plan_session(&mut conns.main, &mut main_proxy).await?;
+        listener.bootstrap_stage("DISPATCH_TEST_PLAN");
+        run_dispatch_loop_until_done_or_disconnect(&mut conns.main, driver, &xctest_config,
+                                                   listener, None).await
+    };
+    let result = tokio::select! {
+        biased;
+        _ = async { if !*cancel.borrow() { let _ = cancel.changed().await; } } => Ok(()),
+        result = execution => result,
+    };
+    // The single native owner is not released until this cleanup and the tunnel
+    // have completed. Never look up a bundle PID: it could belong to a newer run.
+    listener.bootstrap_stage("STOP_RUNNER");
+    let deadline = tokio::time::Instant::now() + std::time::Duration::from_secs(10);
+    let _ = tokio::time::timeout_at(deadline, process_control.service.kill_app_roundtrip(pid)).await;
+    listener.bootstrap_stage("KILL_REQUESTED");
+    drop(process_control);
+    let cleanup = async {
+        let pid = u32::try_from(pid).map_err(|_| IdeviceError::TestRunnerTimeout)?;
+        let mut info = crate::services::dvt::device_info::DeviceInfoClient::new(&mut conns.dvt).await?;
+        listener.bootstrap_stage("PROCESS_STATUS_OPEN");
+        while info.is_running_pid(pid).await? {
+            tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+        }
+        Ok::<_, IdeviceError>(())
+    };
+    match tokio::time::timeout_at(deadline, cleanup).await {
+        Ok(Ok(())) => { listener.bootstrap_stage("PROCESS_EXIT_CONFIRMED"); result },
+        Ok(Err(error)) => {
+            let detail = format!("{error:?}");
+            let variant = detail.split(['(', '{']).next().unwrap_or("unknown");
+            let _ = listener.log_debug_message(&format!("PROCESS_STATUS_ERROR {variant}")).await;
+            if let IdeviceError::UnexpectedResponse(message) = &error {
+                if message.starts_with("isRunningPid") { let _ = listener.log_debug_message(message).await; }
+            }
+            listener.bootstrap_stage("PROCESS_STATUS_FAILED");
+            Err(IdeviceError::UnexpectedResponse("DSH_RUNNER_EXIT_UNCONFIRMED".into()))
+        },
+        _ => { listener.bootstrap_stage("PROCESS_STATUS_TIMEOUT"); Err(IdeviceError::UnexpectedResponse("DSH_RUNNER_EXIT_UNCONFIRMED".into())) },
+    }
+}

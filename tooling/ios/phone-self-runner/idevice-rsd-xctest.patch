+#[cfg(test)]
+mod archive_reference_tests {
+    use super::*;
+
+    fn archive(objects: Vec<Value>) -> AuxValue {
+        let mut top = plist::Dictionary::new();
+        top.insert("root".into(), Value::Uid(plist::Uid::new(1)));
+        let mut root = plist::Dictionary::new();
+        root.insert("$archiver".into(), Value::String("NSKeyedArchiver".into()));
+        root.insert("$version".into(), Value::Integer(100000.into()));
+        root.insert("$top".into(), Value::Dictionary(top));
+        root.insert("$objects".into(), Value::Array(objects));
+        let mut bytes = Vec::new();
+        Value::Dictionary(root).to_writer_binary(&mut bytes).unwrap();
+        AuxValue::Array(bytes)
+    }
+
+    #[test]
+    fn resolves_custom_xctest_object_fields() {
+        let mut activity = plist::Dictionary::new();
+        activity.insert("title".into(), Value::Uid(plist::Uid::new(2)));
+        activity.insert("$class".into(), Value::Uid(plist::Uid::new(3)));
+        let mut class = plist::Dictionary::new();
+        class.insert("$classname".into(), Value::String("XCActivityRecord".into()));
+        let value = decode_aux_archive(&archive(vec![Value::String("$null".into()),
+            Value::Dictionary(activity), Value::String("ready-example".into()),
+            Value::Dictionary(class)])).unwrap();
+        assert_eq!(XCActivityRecord::from_plist(&value).unwrap().title, "ready-example");
+
+        let mut identifier = plist::Dictionary::new();
+        identifier.insert("c".into(), Value::Uid(plist::Uid::new(2)));
+        let value = decode_aux_archive(&archive(vec![Value::String("$null".into()),
+            Value::Dictionary(identifier), Value::Array(vec![Value::Uid(plist::Uid::new(3)),
+                Value::Uid(plist::Uid::new(4))]), Value::String("PhoneRunnerUITests".into()),
+            Value::String("testServe".into())])).unwrap();
+        let id = XCTTestIdentifier::from_plist(&value).unwrap();
+        assert_eq!(id.test_class(), "PhoneRunnerUITests");
+        assert_eq!(id.test_method(), Some("testServe"));
+    }
+}

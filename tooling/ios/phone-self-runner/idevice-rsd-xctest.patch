+/// DSH pre-launch boundary: cancellation is safe before a launch RPC is sent.
+pub async fn run_rsd_prelaunch<T>(
+    cancel: &mut tokio::sync::watch::Receiver<bool>,
+    limit: std::time::Duration,
+    work: impl std::future::Future<Output = Result<T, IdeviceError>>,
+) -> Result<Option<T>, IdeviceError> {
+    tokio::select! {
+        biased;
+        _ = async { if !*cancel.borrow() { let _ = cancel.changed().await; } } => Ok(None),
+        result = tokio::time::timeout(limit, work) =>
+            result.map_err(|_| IdeviceError::TestRunnerTimeout)?.map(Some),
+    }
+}
+
+/// DSH launch boundary: never infer that cancellation undid a submitted launch.
+pub async fn run_rsd_launch(
+    limit: std::time::Duration,
+    work: impl std::future::Future<Output = Result<u64, IdeviceError>>,
+) -> Result<u64, IdeviceError> {
+    let pid = tokio::time::timeout(limit, work).await
+        .map_err(|_| IdeviceError::UnexpectedResponse("DSH_RUNNER_EXIT_UNCONFIRMED".into()))?
+        .map_err(|_| IdeviceError::UnexpectedResponse("DSH_RUNNER_EXIT_UNCONFIRMED".into()))?;
+    if pid == 0 || pid > u32::MAX as u64 {
+        return Err(IdeviceError::UnexpectedResponse("DSH_RUNNER_EXIT_UNCONFIRMED".into()));
+    }
+    Ok(pid)
+}

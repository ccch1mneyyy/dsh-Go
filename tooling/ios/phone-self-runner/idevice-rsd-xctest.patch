+//! Synthetic memory transport only. No sockets, devices, files or timer sleeps.
+use super::*;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::{Arc, Mutex};
+use std::task::{Context, Poll, Waker};
+use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
+
+#[derive(Debug)]
+struct State {
+    incoming: VecDeque<u8>,
+    written: Vec<u8>,
+    write_budget: Option<usize>,
+    flush_ready: bool,
+    dropped: bool,
+}
+#[derive(Debug)]
+struct MemoryIo(Arc<Mutex<State>>);
+impl Drop for MemoryIo {
+    fn drop(&mut self) { self.0.lock().unwrap().dropped = true; }
+}
+impl AsyncRead for MemoryIo {
+    fn poll_read(self: Pin<&mut Self>, _: &mut Context<'_>, buf: &mut ReadBuf<'_>) -> Poll<std::io::Result<()>> {
+        let mut state = self.0.lock().unwrap();
+        if state.incoming.is_empty() { return Poll::Pending; }
+        let count = buf.remaining().min(state.incoming.len());
+        for _ in 0..count { buf.put_slice(&[state.incoming.pop_front().unwrap()]); }
+        Poll::Ready(Ok(()))
+    }
+}
+impl AsyncWrite for MemoryIo {
+    fn poll_write(self: Pin<&mut Self>, _: &mut Context<'_>, bytes: &[u8]) -> Poll<std::io::Result<usize>> {
+        let mut state = self.0.lock().unwrap();
+        let count = bytes.len().min(state.write_budget.unwrap_or(usize::MAX));
+        if count == 0 { return Poll::Pending; }
+        state.written.extend_from_slice(&bytes[..count]);
+        if let Some(budget) = &mut state.write_budget { *budget -= count; }
+        Poll::Ready(Ok(count))
+    }
+    fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+        if self.0.lock().unwrap().flush_ready { Poll::Ready(Ok(())) } else { Poll::Pending }
+    }
+    fn poll_shutdown(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+        Poll::Ready(Ok(()))
+    }
+}
+async fn new_client() -> (Http2Client<MemoryIo>, Arc<Mutex<State>>) {
+    let state = Arc::new(Mutex::new(State {
+        incoming: VecDeque::new(), written: Vec::new(), write_budget: None,
+        flush_ready: true, dropped: false,
+    }));
+    let client = Http2Client::new(MemoryIo(state.clone())).await.unwrap();
+    assert_eq!(state.lock().unwrap().written, HTTP2_MAGIC);
+    state.lock().unwrap().written.clear();
+    (client, state)
+}
+fn wire(kind: u8, flags: u8, stream: u32, body: &[u8]) -> Vec<u8> {
+    let mut bytes = (body.len() as u32).to_be_bytes()[1..].to_vec();
+    bytes.extend_from_slice(&[kind, flags]);
+    bytes.extend_from_slice(&stream.to_be_bytes());
+    bytes.extend_from_slice(body);
+    bytes
+}
+fn input(state: &Arc<Mutex<State>>, bytes: &[u8]) {
+    state.lock().unwrap().incoming.extend(bytes);
+}
+fn pending(future: impl Future) {
+    let mut future = Box::pin(future);
+    let mut context = Context::from_waker(Waker::noop());
+    assert!(future.as_mut().poll(&mut context).is_pending());
+    // Dropping the future here is the tested cancellation boundary.
+}
+fn data(stream_id: u32, count: usize, end_stream: bool) -> frame::DataFrame {
+    frame::DataFrame { stream_id, payload: vec![7; count], flow_control_len: count, end_stream }
+}
+fn increments(bytes: &[u8]) -> Vec<(u32, u32)> {
+    assert_eq!(bytes.len() % 13, 0);
+    bytes.chunks_exact(13).map(|frame| {
+        assert_eq!(&frame[..5], &[0, 0, 4, 8, 0]);
+        (u32::from_be_bytes(frame[5..9].try_into().unwrap()),
+         u32::from_be_bytes(frame[9..13].try_into().unwrap()))
+    }).collect()
+}

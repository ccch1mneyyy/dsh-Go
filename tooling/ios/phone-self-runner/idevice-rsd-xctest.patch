new file mode 100644
--- /dev/null
+++ b/idevice/src/xpc/object_limits.rs
@@ -0,0 +1,67 @@
+//! Shared, cumulative bounds for decoded XPC objects and plist conversion.
+use crate::IdeviceError;
+
+pub(super) const MAX_DEPTH: usize = 64;
+pub(super) const MAX_OBJECTS: usize = 65_536;
+pub(super) const MAX_DYNAMIC_BYTES: usize = 16 * 1024 * 1024;
+
+pub(super) fn limit(kind: &str) -> IdeviceError {
+    IdeviceError::UnexpectedResponse(format!("RemoteXPC object {kind} exceeds limit"))
+}
+
+pub(super) struct Budget {
+    objects_left: usize,
+    bytes_left: usize,
+}
+impl Budget {
+    pub(super) fn new() -> Self {
+        Self { objects_left: MAX_OBJECTS, bytes_left: MAX_DYNAMIC_BYTES }
+    }
+    pub(super) fn enter(&mut self, depth: usize) -> Result<(), IdeviceError> {
+        if depth > MAX_DEPTH { return Err(limit("depth")); }
+        if self.objects_left == 0 { return Err(limit("count")); }
+        self.objects_left -= 1;
+        Ok(())
+    }
+    /// Reject an impossible container width before iterating. Do not reserve
+    /// storage based on this declaration: children consume the shared counter
+    /// as they are actually decoded or converted.
+    pub(super) fn children(&self, count: usize) -> Result<(), IdeviceError> {
+        if count > self.objects_left { return Err(limit("count")); }
+        Ok(())
+    }
+    pub(super) fn bytes(&mut self, count: usize) -> Result<(), IdeviceError> {
+        if count > self.bytes_left { return Err(limit("payload bytes")); }
+        self.bytes_left -= count;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cumulative_objects_include_containers_and_nulls() {
+        let mut budget = Budget::new();
+        budget.enter(1).unwrap();
+        budget.children(MAX_OBJECTS - 1).unwrap();
+        assert!(budget.children(MAX_OBJECTS).is_err());
+        for _ in 1..MAX_OBJECTS { budget.enter(2).unwrap(); }
+        assert!(budget.enter(2).is_err());
+    }
+    #[test]
+    fn byte_budget_cannot_wrap_and_includes_prior_siblings() {
+        let mut budget = Budget::new();
+        budget.bytes(MAX_DYNAMIC_BYTES - 7).unwrap();
+        budget.bytes(7).unwrap();
+        assert!(budget.bytes(1).is_err());
+        assert!(budget.bytes(usize::MAX).is_err());
+    }
+    #[test]
+    fn depth_is_checked_before_the_next_descent() {
+        let mut budget = Budget::new();
+        for depth in 1..=MAX_DEPTH { budget.enter(depth).unwrap(); }
+        assert!(budget.enter(MAX_DEPTH + 1).is_err());
+    }
+}

+#[test]
+fn frame_header_limit_padding_and_reserved_bits() {
+    let mut oversized = wire(0, 0, 1, &[]);
+    oversized[..3].copy_from_slice(&[0, 0x40, 1]);
+    assert!(frame::Frame::parse(&oversized).unwrap_err().to_string().contains("payload exceeds"));
+    let exact = wire(0, 0, 1, &vec![0; frame::MAX_FRAME_PAYLOAD]);
+    assert!(matches!(frame::Frame::parse(&exact).unwrap(), Some((frame::Frame::Data(_), _))));
+    let padded = wire(0, 8, 0x8000_0001, &[2, b'a', b'b', 0, 0]);
+    let Some((frame::Frame::Data(parsed), count)) = frame::Frame::parse(&padded).unwrap() else { panic!() };
+    assert_eq!(parsed.stream_id, 1);
+    assert_eq!(parsed.payload, b"ab");
+    assert_eq!(parsed.flow_control_len, 5);
+    assert_eq!(count, 14);
+    assert!(frame::Frame::parse(&wire(0, 8, 1, &[])).is_err());
+    assert!(frame::Frame::parse(&wire(0, 8, 1, &[1])).is_err());
+    assert!(frame::Frame::parse(&wire(0, 0, 0, &[])).is_err());
+    assert!(frame::Frame::parse(&wire(8, 0, 1, &[0; 4])).is_err());
+    assert!(frame::Frame::parse(&wire(4, 1, 0, &[0; 6])).is_err());
+}

+    /// Send SIGKILL and wait for the matching DTX reply before closing anything.
+    /// The caller still must independently confirm this exact PID has exited.
+    pub(crate) async fn kill_app_roundtrip(&mut self, pid: u64) -> Result<(), IdeviceError> {
+        self.channel.call_method_with_reply(
+            Some(Value::String("sendSignal:toPid:".into())),
+            Some(vec![
+                AuxValue::archived_value(Value::Integer(9.into())),
+                AuxValue::archived_value(Value::Integer((pid as i64).into())),
+            ]),
+        ).await?;
+        Ok(())
+    }

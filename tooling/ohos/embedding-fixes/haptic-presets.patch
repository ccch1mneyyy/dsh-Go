+  private async vibratePreset(effectId: string, intensity: number, fallbackMs: number): Promise<void> {
+    if (await PlatformPluginCallback.hasHapticPreset(effectId)) {
+      await vibrator.startVibration({ type: 'preset', effectId: effectId, intensity: intensity },
+        { id: 0, usage: 'touch' });
+    } else {
+      await vibrator.startVibration({ type: 'time', duration: fallbackMs },
+        { id: 0, usage: 'touch' });
+    }
+  }
+
+  // Asked once per preset, and not with isSupportEffectSync, which blocks the UI thread a tap is on.
+  private static async hasHapticPreset(effectId: string): Promise<boolean> {
+    let known = PlatformPluginCallback.hapticPresets.get(effectId);
+    if (known === undefined) {
+      try {
+        known = await vibrator.isSupportEffect(effectId);
+      } catch (err) {
+        Log.w(PlatformPluginCallback.TAG, "isSupportEffect " + effectId + ": " + JSON.stringify(err));
+        known = false;
+      }
+      PlatformPluginCallback.hapticPresets.set(effectId, known);
+    }
+    return known;
+  }

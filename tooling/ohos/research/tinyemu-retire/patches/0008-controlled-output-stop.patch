+/* New controlled ABI: caller owns a stream socket writer, and serializes the
+   one global VM. Return does not release VM devices or authorize another run. */
+int temu_embed_run_controlled(const char *path, int in_fd, int out_fd,
+                             TemuInitialized initialized, TemuShouldStop stop,
+                             void *opaque)
+{
+    int type;
+    socklen_t size = sizeof(type);
+    int result;
+    if (!stop || getsockopt(out_fd, SOL_SOCKET, SO_TYPE, &type, &size) < 0 ||
+        type != SOCK_STREAM)
+        return TEMU_EMBED_RETRYABLE_START_FAILURE;
+    if (atomic_flag_test_and_set(&embed_control_claimed))
+        return TEMU_EMBED_OWNER_UNRELEASED;
+    embed_controlled = 1;
+    embed_should_stop = stop;
+    embed_control_opaque = opaque;
+    embed_output_failed = 0;
+    result = temu_embed_run_initialized(path, in_fd, out_fd, initialized, opaque);
+    embed_controlled = 0;
+    embed_should_stop = NULL;
+    embed_control_opaque = NULL;
+    return result;
+}

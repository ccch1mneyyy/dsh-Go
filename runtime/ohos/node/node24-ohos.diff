 void NodeMainInstance::Run(ExitCode* exit_code, Environment* env) {
+#if defined(__OHOS__) && defined(DSH_GO_EMBEDDED_RUNTIME)
+  bool exit_requested = false;
+  SetProcessExitHandler(env, [exit_code, &exit_requested](Environment* target, int code) {
+    *exit_code = static_cast<ExitCode>(code);
+    exit_requested = true;
+    Stop(target);
+  });
+#endif
   if (*exit_code == ExitCode::kNoFailure) {
     if (!sea::MaybeLoadSingleExecutableApplication(env)) {
       LoadEnvironment(env, StartExecutionCallbackWithModule{});
     }
 
+#if defined(__OHOS__) && defined(DSH_GO_EMBEDDED_RUNTIME)
+    const auto loop_result = SpinEventLoopInternal(env);
+    if (!exit_requested)
+      *exit_code = loop_result.FromMaybe(ExitCode::kGenericUserError);
+#else
     *exit_code =
         SpinEventLoopInternal(env).FromMaybe(ExitCode::kGenericUserError);
+#endif
   }
 

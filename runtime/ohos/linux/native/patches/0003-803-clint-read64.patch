+/* A naturally aligned RV64 load must sample mtime only once. */
+static uint64_t clint_read64(void *opaque, uint32_t offset)
+{
+    RISCVMachine *m = opaque;
+
+    switch(offset) {
+    case 0xbff8:
+        return rtc_get_time(m);
+    case 0x4000:
+        return m->timecmp;
+    default:
+        return 0;
+    }
+}

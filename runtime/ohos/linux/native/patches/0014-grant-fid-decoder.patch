+#ifdef CONFIG_FS_GRANT
+/* Trusted owner ONLY after machine thread join. No transport callback may run. */
+int virtio_9p_grant_quiesced(FSDevice *fs) {
+    VIRTIO9PDevice *s=grant_device;
+    if (!s || s->fs!=fs || s->req_in_progress) return -1;
+    while (!list_empty(&s->fid_list)) {
+        FIDDesc *old=list_entry(s->fid_list.next,FIDDesc,link);
+        fid_delete(s,old->fid);
+    }
+    return 0;
+}

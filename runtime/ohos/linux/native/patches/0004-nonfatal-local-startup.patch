+#ifdef TEMU_EMBED
+/* The embedded startup path cannot use the CLI loader's fatal exits or its
+   asynchronous URL callbacks. This reader owns and closes only its local FILE. */
+static int load_file_local(uint8_t **pbuf, const char *filename)
+{
+    FILE *f = NULL;
+    uint8_t *buf = NULL;
+    long size;
+    int error;
+
+    *pbuf = NULL;
+    f = fopen(filename, "rb");
+    if (!f)
+        goto fail;
+    if (fseek(f, 0, SEEK_END) != 0 || (size = ftell(f)) < 0 ||
+        fseek(f, 0, SEEK_SET) != 0)
+        goto fail;
+    if (size > INT_MAX) {
+        errno = EFBIG;
+        goto fail;
+    }
+    buf = malloc((size_t)size + 1);
+    if (!buf) {
+        errno = ENOMEM;
+        goto fail;
+    }
+    if (fread(buf, 1, (size_t)size, f) != (size_t)size) {
+        if (!ferror(f) || !errno)
+            errno = EIO;
+        goto fail;
+    }
+    if (fclose(f) != 0) {
+        f = NULL;
+        goto fail;
+    }
+    buf[size] = 0;
+    *pbuf = buf;
+    return (int)size;
+
+ fail:
+    error = errno ? errno : EIO;
+    if (f)
+        fclose(f);
+    free(buf);
+    errno = error;
+    perror(filename);
+    errno = error;
+    return -1;
+}
+
+int virt_machine_load_config_file_local(VirtMachineParams *p,
+                                        const char *filename)
+{
+    uint8_t *config = NULL;
+    int len, i, error;
+
+    p->cfg_filename = strdup(filename);
+    if (!p->cfg_filename) {
+        errno = ENOMEM;
+        goto fail;
+    }
+    len = load_file_local(&config, filename);
+    if (len < 0)
+        goto fail;
+    if (virt_machine_parse_config(p, (char *)config, len) < 0) {
+        errno = EINVAL;
+        goto fail;
+    }
+    free(config);
+    config = NULL;
+    for(i = 0; i < VM_FILE_COUNT; i++) {
+        char *fname;
+        if (!p->files[i].filename)
+            continue;
+        fname = get_file_path(p->cfg_filename, p->files[i].filename);
+        if (!fname) {
+            errno = ENOMEM;
+            goto fail;
+        }
+        len = load_file_local(&p->files[i].buf, fname);
+        error = errno;
+        free(fname);
+        errno = error;
+        if (len < 0)
+            goto fail;
+        p->files[i].len = len;
+    }
+    return 0;
+
+ fail:
+    error = errno;
+    free(config);
+    virt_machine_free_config(p);
+    virt_machine_set_defaults(p);
+    errno = error;
+    return -1;
+}
+#endif

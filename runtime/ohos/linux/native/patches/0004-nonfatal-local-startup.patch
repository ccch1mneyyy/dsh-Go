+#ifdef TEMU_EMBED
+static void block_device_file_close(BlockDevice *bs)
+{
+    BlockDeviceFile *bf;
+    int64_t i;
+
+    if (!bs)
+        return;
+    bf = bs->opaque;
+    fclose(bf->f);
+    if (bf->sector_table) {
+        for(i = 0; i < bf->nb_sectors; i++)
+            free(bf->sector_table[i]);
+        free(bf->sector_table);
+    }
+    free(bf);
+    free(bs);
+}

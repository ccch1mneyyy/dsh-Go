[{"name":"apps","description":"列出这台手机上能打开的应用（名称 · 包名）。","inputSchema":{"type":"object","properties":{"query":{"type":"string","description":"按名称或包名筛选，可省略"}},"additionalProperties":false}},{"name":"open","description":"打开应用或链接（app 或 url 二选一）。background:true 在后台屏打开（需用户开通不打扰模式）；无障碍开着时返回新屏幕。","inputSchema":{"type":"object","properties":{"app":{"type":"string","description":"包名或应用名"},"url":{"type":"string","description":"网址或深链"},"background":{"type":"boolean","description":"在后台屏打开"}},"additionalProperties":false}},{"name":"intent","description":"用系统意图办事（最后一步用户在对方界面确认），能办就别点界面。字段按 kind：alarm(hour,minute,days?,message?)、timer(seconds,message?)、calendar(title,begin,end?,all_day?,location?,description?)、dial(number)、sms_draft(number?,text)、share(text,app?)、navigate(destination|lat+lng,mode?,map?)、settings(page,app?)。","inputSchema":{"type":"object","properties":{"kind":{"type":"string","enum":["alarm","timer","calendar","dial","sms_draft","share","navigate","settings"],"description":"事务类型"},"hour":{"type":"integer","description":"时 0–23"},"minute":{"type":"integer","description":"分 0–59"},"days":{"type":"array","items":{"type":"integer"},"description":"重复的星期，1=周一 … 7=周日；省略只响一次"},"seconds":{"type":"integer","description":"秒 1–86400"},"message":{"type":"string","description":"闹钟 / 计时器标签"},"title":{"type":"string","description":"日程标题"},"begin":{"type":"string","description":"开始，如 2026-10-24T19:00（手机时区）；全天写 2026-10-24"},"end":{"type":"string","description":"结束，省略 = 开始后 1 小时"},"all_day":{"type":"boolean","description":"全天"},"location":{"type":"string","description":"地点"},"description":{"type":"string","description":"备注"},"number":{"type":"string","description":"电话号码"},"text":{"type":"string","description":"文字内容"},"app":{"type":"string","description":"分享目标应用（省略弹分享面板）；settings:app_notifications 用哪个应用"},"destination":{"type":"string","description":"目的地名称或地址"},"lat":{"type":"number","description":"纬度 GCJ-02"},"lng":{"type":"number","description":"经度 GCJ-02"},"mode":{"type":"string","enum":["drive","transit","walk","ride"],"description":"出行方式，默认 drive"},"map":{"type":"string","enum":["amap","baidu"],"description":"地图，默认先高德再百度"},"page":{"type":"string","enum":["home","wifi","bluetooth","mobile_network","airplane","display","sound","battery","location","date","language","storage","nfc","app_notifications"],"description":"设置页；app_notifications 还需 app"}},"required":["kind"],"additionalProperties":false}},{"name":"notify","description":"给用户发一条手机通知。","inputSchema":{"type":"object","properties":{"title":{"type":"string","description":"标题"},"text":{"type":"string","description":"正文"}},"required":["title","text"],"additionalProperties":false}},{"name":"clipboard","description":"读写剪贴板：set 写入文字；get:true 读取（系统只允许前台应用读，DSH 不在前台时读不到）。","inputSchema":{"type":"object","properties":{"set":{"type":"string","description":"要写入的文字"},"get":{"type":"boolean","description":"读取剪贴板"}},"additionalProperties":false}},{"name":"screen","description":"读当前屏幕：每行一个元素，[编号] 只在本屏有效。detail:true 附坐标；image:true 附标号截图；background:true 读后台屏。","inputSchema":{"type":"object","properties":{"detail":{"type":"boolean","description":"附上元素坐标"},"image":{"type":"boolean","description":"附带标号截图"},"background":{"type":"boolean","description":"读后台屏（不打扰模式）"}},"additionalProperties":false}},{"name":"collect","description":"只读：自动滚动列表收集全部条目（按文字去重），读长列表只用这一次。","inputSchema":{"type":"object","properties":{"screen":{"type":"string","description":"屏幕号，如 s7（主屏）或 b3（后台屏），取自最近一次返回的屏幕"},"list":{"type":"integer","description":"列表的编号"},"max_pages":{"type":"integer","description":"最多翻几页（1–30），默认 10"},"until":{"type":"string","description":"出现这段文字就停"}},"required":["screen","list"],"additionalProperties":false}},{"name":"tap","description":"点一个元素，返回新屏幕。敏感按钮或首次操作该 App 会先请用户确认。","inputSchema":{"type":"object","properties":{"screen":{"type":"string","description":"屏幕号，如 s7（主屏）或 b3（后台屏），取自最近一次返回的屏幕"},"id":{"type":"integer","description":"元素编号"},"long":{"type":"boolean","description":"长按"}},"required":["screen","id"],"additionalProperties":false}},{"name":"type","description":"在输入框输入文字（替换原内容），返回回读和新屏幕。submit:true 后按回车 / 发送，要确认。密码、验证码、支付框默认拒绝，被拒绝就 handoff。","inputSchema":{"type":"object","properties":{"screen":{"type":"string","description":"屏幕号，如 s7（主屏）或 b3（后台屏），取自最近一次返回的屏幕"},"id":{"type":"integer","description":"输入框编号"},"text":{"type":"string","description":"要输入的文字"},"submit":{"type":"boolean","description":"输入后提交 / 发送"}},"required":["screen","id","text"],"additionalProperties":false}},{"name":"scroll","description":"滚动，返回新屏幕。id 是要滚动的列表，省略时滚主列表。","inputSchema":{"type":"object","properties":{"screen":{"type":"string","description":"屏幕号，如 s7（主屏）或 b3（后台屏），取自最近一次返回的屏幕"},"id":{"type":"integer","description":"列表编号，可省略"},"direction":{"type":"string","enum":["up","down","left","right"],"description":"方向"}},"required":["screen","direction"],"additionalProperties":false}},{"name":"key","description":"按系统键（back / home / recents / notifications），返回新屏幕。","inputSchema":{"type":"object","properties":{"key":{"type":"string","enum":["back","home","recents","notifications"],"description":"按键"},"screen":{"type":"string","description":"屏幕号；省略时作用于主屏"}},"required":["key"],"additionalProperties":false}},{"name":"tap_xy","description":"按标号截图的像素坐标点击，只在元素里找不到目标时用；每次都要用户确认。","inputSchema":{"type":"object","properties":{"observation":{"type":"string","description":"那张截图的屏幕号"},"x":{"type":"integer","description":"横坐标（像素，从 0 开始）"},"y":{"type":"integer","description":"纵坐标（像素，从 0 开始）"}},"required":["observation","x","y"],"additionalProperties":false}},{"name":"handoff","description":"把手机交给用户完成登录、验证码、支付或没把握的步骤；等用户点「继续」或「停止」，最长 10 分钟。","inputSchema":{"type":"object","properties":{"reason":{"type":"string","description":"要用户做什么，一句话"}},"required":["reason"],"additionalProperties":false}}]
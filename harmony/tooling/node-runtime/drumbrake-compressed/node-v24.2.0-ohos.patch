+// 兼容解释器旧编码，索引类型从模块恢复共享性和种类。
+static HeapType InterpreterHeapType(uint32_t value, const WasmModule* module) {
+  if (value < kV8MaxWasmTypes) return module->heap_type(ModuleTypeIndex{value});
+  switch (value) {
+    case HeapType::kFunc: return HeapType::Generic(GenericKind::kFunc, false);
+    case HeapType::kEq: return HeapType::Generic(GenericKind::kEq, false);
+    case HeapType::kI31: return HeapType::Generic(GenericKind::kI31, false);
+    case HeapType::kStruct: return HeapType::Generic(GenericKind::kStruct, false);
+    case HeapType::kArray: return HeapType::Generic(GenericKind::kArray, false);
+    case HeapType::kAny: return HeapType::Generic(GenericKind::kAny, false);
+    case HeapType::kExtern: return HeapType::Generic(GenericKind::kExtern, false);
+    case HeapType::kExternString: return HeapType::Generic(GenericKind::kExternString, false);
+    case HeapType::kExn: return HeapType::Generic(GenericKind::kExn, false);
+    case HeapType::kString: return HeapType::Generic(GenericKind::kString, false);
+    case HeapType::kStringViewWtf8: return HeapType::Generic(GenericKind::kStringViewWtf8, false);
+    case HeapType::kStringViewWtf16: return HeapType::Generic(GenericKind::kStringViewWtf16, false);
+    case HeapType::kStringViewIter: return HeapType::Generic(GenericKind::kStringViewIter, false);
+    case HeapType::kNone: return HeapType::Generic(GenericKind::kNone, false);
+    case HeapType::kNoFunc: return HeapType::Generic(GenericKind::kNoFunc, false);
+    case HeapType::kNoExtern: return HeapType::Generic(GenericKind::kNoExtern, false);
+    case HeapType::kNoExn: return HeapType::Generic(GenericKind::kNoExn, false);
+    case HeapType::kCont: return HeapType::Generic(GenericKind::kCont, false);
+    case HeapType::kContShared: return HeapType::Generic(GenericKind::kCont, true);
+    case HeapType::kNoCont: return HeapType::Generic(GenericKind::kNoCont, false);
+    case HeapType::kFuncShared: return HeapType::Generic(GenericKind::kFunc, true);
+    case HeapType::kEqShared: return HeapType::Generic(GenericKind::kEq, true);
+    case HeapType::kI31Shared: return HeapType::Generic(GenericKind::kI31, true);
+    case HeapType::kStructShared: return HeapType::Generic(GenericKind::kStruct, true);
+    case HeapType::kArrayShared: return HeapType::Generic(GenericKind::kArray, true);
+    case HeapType::kAnyShared: return HeapType::Generic(GenericKind::kAny, true);
+    case HeapType::kExternShared: return HeapType::Generic(GenericKind::kExtern, true);
+    case HeapType::kExternStringShared: return HeapType::Generic(GenericKind::kExternString, true);
+    case HeapType::kExnShared: return HeapType::Generic(GenericKind::kExn, true);
+    case HeapType::kStringShared: return HeapType::Generic(GenericKind::kString, true);
+    case HeapType::kStringViewWtf8Shared: return HeapType::Generic(GenericKind::kStringViewWtf8, true);
+    case HeapType::kStringViewWtf16Shared: return HeapType::Generic(GenericKind::kStringViewWtf16, true);
+    case HeapType::kStringViewIterShared: return HeapType::Generic(GenericKind::kStringViewIter, true);
+    case HeapType::kNoneShared: return HeapType::Generic(GenericKind::kNone, true);
+    case HeapType::kNoFuncShared: return HeapType::Generic(GenericKind::kNoFunc, true);
+    case HeapType::kNoExternShared: return HeapType::Generic(GenericKind::kNoExtern, true);
+    case HeapType::kNoExnShared: return HeapType::Generic(GenericKind::kNoExn, true);
+    case HeapType::kNoContShared: return HeapType::Generic(GenericKind::kNoCont, true);
+    case HeapType::kTop: return HeapType::Generic(GenericKind::kTop, false);
+    case HeapType::kBottom: return HeapType::Generic(GenericKind::kBottom, false);
+    default: UNREACHABLE();
